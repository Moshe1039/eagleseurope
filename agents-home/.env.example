# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Cloudflare API token, scoped read-only: Workers Scripts:Read + Account Analytics:Read
# Create at: Cloudflare dashboard -> My Profile -> API Tokens -> Create Token
CLOUDFLARE_API_TOKEN=

# From the dashboard URL you shared
CLOUDFLARE_ACCOUNT_ID=38d4bc1f1e271243e7da47ec29fd035c
CLOUDFLARE_WORKER_NAME=eagleseurope

# Same credentials as the Worker's ADMIN_USER / ADMIN_PASSWORD secrets (see the eagleseurope
# repo's README) -- used to pull the real lead list from https://eagleseurope.com/admin/leads.csv
ADMIN_USER=
ADMIN_PASSWORD=

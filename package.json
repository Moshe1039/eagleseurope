{
  "name": "eagleseurope",
  "private": true,
  "description": "Eagle's Europe – website and lead database (Cloudflare Pages + D1)",
  "scripts": {
    "build": "python3 scripts/build.py",
    "db:migrate:local": "wrangler d1 migrations apply eagleseurope-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply eagleseurope-leads --remote",
    "dev": "npm run build && wrangler pages dev public"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/jost": "^5.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
